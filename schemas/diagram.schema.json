{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://local.fluent-slide-kit/schemas/diagram.schema.json",
    "title": "Fluent workflow diagram",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "diagramType",
        "id",
        "title",
        "theme",
        "nodes",
        "edges"
    ],
    "properties": {
        "schemaVersion": {
            "const": 1
        },
        "diagramType": {
            "const": "flow"
        },
        "id": {
            "$ref": "#/$defs/id"
        },
        "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
        },
        "description": {
            "type": "string",
            "maxLength": 280
        },
        "direction": {
            "enum": [
                "right",
                "down"
            ],
            "default": "right"
        },
        "theme": {
            "enum": [
                "light",
                "dark"
            ]
        },
        "allowCycles": {
            "type": "boolean",
            "default": false
        },
        "rankSkipRouting": {
            "enum": [
                "horizontal-channel"
            ]
        },
        "nodes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 30,
            "items": {
                "$ref": "#/$defs/node"
            }
        },
        "edges": {
            "type": "array",
            "minItems": 1,
            "maxItems": 60,
            "items": {
                "$ref": "#/$defs/edge"
            }
        },
        "groups": {
            "type": "array",
            "maxItems": 8,
            "items": {
                "$ref": "#/$defs/group"
            }
        },
        "lanes": {
            "type": "array",
            "maxItems": 8,
            "items": {
                "$ref": "#/$defs/lane"
            }
        },
        "legend": {
            "type": "array",
            "maxItems": 6,
            "items": {
                "$ref": "#/$defs/legendItem"
            }
        }
    },
    "$defs": {
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "tone": {
            "enum": [
                "neutral",
                "brand",
                "success",
                "warning",
                "danger"
            ]
        },
        "asset": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind",
                "path",
                "alt"
            ],
            "properties": {
                "kind": {
                    "enum": [
                        "fluent",
                        "azure",
                        "external"
                    ]
                },
                "path": {
                    "type": "string",
                    "pattern": "^assets/[^.].+\\.svg$"
                },
                "alt": {
                    "type": "string",
                    "maxLength": 160
                }
            }
        },
        "node": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "label",
                "kind"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                },
                "description": {
                    "type": "string",
                    "maxLength": 120
                },
                "kind": {
                    "enum": [
                        "azure-service",
                        "process",
                        "decision",
                        "data-store",
                        "queue",
                        "actor",
                        "external-system"
                    ]
                },
                "tone": {
                    "$ref": "#/$defs/tone"
                },
                "asset": {
                    "$ref": "#/$defs/asset"
                },
                "group": {
                    "$ref": "#/$defs/id"
                },
                "lane": {
                    "$ref": "#/$defs/id"
                }
            }
        },
        "edge": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "source",
                "target"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "source": {
                    "$ref": "#/$defs/id"
                },
                "target": {
                    "$ref": "#/$defs/id"
                },
                "label": {
                    "type": "string",
                    "maxLength": 60
                },
                "labelPosition": {
                    "enum": [
                        "source",
                        "middle",
                        "target"
                    ]
                },
                "kind": {
                    "enum": [
                        "primary",
                        "asynchronous",
                        "dependency",
                        "error"
                    ],
                    "default": "primary"
                },
                "bidirectional": {
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "group": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "label"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                },
                "tone": {
                    "$ref": "#/$defs/tone"
                },
                "parentGroup": {
                    "$ref": "#/$defs/id"
                },
                "borderStyle": {
                    "enum": [
                        "solid",
                        "dashed",
                        "dotted"
                    ],
                    "default": "dashed"
                }
            }
        },
        "lane": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "label"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                },
                "tone": {
                    "$ref": "#/$defs/tone"
                }
            }
        },
        "legendItem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "label",
                "kind"
            ],
            "properties": {
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                },
                "kind": {
                    "enum": [
                        "primary",
                        "asynchronous",
                        "dependency",
                        "error"
                    ]
                }
            }
        }
    }
}