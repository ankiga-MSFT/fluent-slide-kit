{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://local.fluent-slide-kit/schemas/diagram.schema.json",
    "title": "Fluent architecture or workflow diagram",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "diagramType",
        "id",
        "title",
        "theme"
    ],
    "properties": {
        "schemaVersion": {
            "const": 1
        },
        "diagramType": {
            "enum": [
                "flow",
                "layered-architecture"
            ]
        },
        "id": {
            "$ref": "#/$defs/id"
        },
        "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
        },
        "description": {
            "type": "string",
            "maxLength": 280
        },
        "direction": {
            "enum": [
                "right",
                "down"
            ],
            "default": "right"
        },
        "theme": {
            "enum": [
                "light",
                "dark"
            ]
        },
        "allowCycles": {
            "type": "boolean",
            "default": false
        },
        "nodes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 30,
            "items": {
                "$ref": "#/$defs/node"
            }
        },
        "edges": {
            "type": "array",
            "minItems": 1,
            "maxItems": 60,
            "items": {
                "$ref": "#/$defs/edge"
            }
        },
        "groups": {
            "type": "array",
            "maxItems": 8,
            "items": {
                "$ref": "#/$defs/group"
            }
        },
        "lanes": {
            "type": "array",
            "maxItems": 8,
            "items": {
                "$ref": "#/$defs/lane"
            }
        },
        "legend": {
            "type": "array",
            "maxItems": 6,
            "items": {
                "$ref": "#/$defs/legendItem"
            }
        },
        "columns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
                "$ref": "#/$defs/column"
            }
        },
        "layers": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
                "$ref": "#/$defs/layer"
            }
        },
        "crossCuttingConcerns": {
            "type": "array",
            "maxItems": 5,
            "items": {
                "$ref": "#/$defs/concern"
            }
        },
        "showLayerFlow": {
            "type": "boolean",
            "default": true
        }
    },
    "oneOf": [
        {
            "properties": {
                "diagramType": {
                    "const": "flow"
                }
            },
            "required": [
                "nodes",
                "edges"
            ],
            "not": {
                "anyOf": [
                    {
                        "required": [
                            "layers"
                        ]
                    },
                    {
                        "required": [
                            "columns"
                        ]
                    },
                    {
                        "required": [
                            "crossCuttingConcerns"
                        ]
                    }
                ]
            }
        },
        {
            "properties": {
                "diagramType": {
                    "const": "layered-architecture"
                }
            },
            "required": [
                "columns",
                "layers"
            ],
            "not": {
                "anyOf": [
                    {
                        "required": [
                            "nodes"
                        ]
                    },
                    {
                        "required": [
                            "edges"
                        ]
                    },
                    {
                        "required": [
                            "lanes"
                        ]
                    },
                    {
                        "required": [
                            "groups"
                        ]
                    },
                    {
                        "required": [
                            "legend"
                        ]
                    }
                ]
            }
        }
    ],
    "$defs": {
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "tone": {
            "enum": [
                "neutral",
                "brand",
                "success",
                "warning",
                "danger"
            ]
        },
        "asset": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind",
                "path",
                "alt"
            ],
            "properties": {
                "kind": {
                    "enum": [
                        "fluent",
                        "azure"
                    ]
                },
                "path": {
                    "type": "string",
                    "pattern": "^assets/[^.].+\\.svg$"
                },
                "alt": {
                    "type": "string",
                    "maxLength": 160
                }
            }
        },
        "node": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "label",
                "kind"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                },
                "description": {
                    "type": "string",
                    "maxLength": 120
                },
                "kind": {
                    "enum": [
                        "azure-service",
                        "process",
                        "decision",
                        "data-store",
                        "queue",
                        "actor",
                        "external-system"
                    ]
                },
                "tone": {
                    "$ref": "#/$defs/tone"
                },
                "asset": {
                    "$ref": "#/$defs/asset"
                },
                "group": {
                    "$ref": "#/$defs/id"
                },
                "lane": {
                    "$ref": "#/$defs/id"
                }
            }
        },
        "edge": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "source",
                "target"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "source": {
                    "$ref": "#/$defs/id"
                },
                "target": {
                    "$ref": "#/$defs/id"
                },
                "label": {
                    "type": "string",
                    "maxLength": 60
                },
                "kind": {
                    "enum": [
                        "primary",
                        "asynchronous",
                        "dependency",
                        "error"
                    ],
                    "default": "primary"
                },
                "bidirectional": {
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "group": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "label"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                },
                "tone": {
                    "$ref": "#/$defs/tone"
                }
            }
        },
        "lane": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "label"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                },
                "tone": {
                    "$ref": "#/$defs/tone"
                }
            }
        },
        "legendItem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "label",
                "kind"
            ],
            "properties": {
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                },
                "kind": {
                    "enum": [
                        "primary",
                        "asynchronous",
                        "dependency",
                        "error"
                    ]
                }
            }
        },
        "column": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "label"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                }
            }
        },
        "component": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "label",
                "column"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 48
                },
                "description": {
                    "type": "string",
                    "maxLength": 80
                },
                "column": {
                    "$ref": "#/$defs/id"
                },
                "span": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5,
                    "default": 1
                },
                "tone": {
                    "$ref": "#/$defs/tone"
                },
                "emphasis": {
                    "type": "boolean",
                    "default": false
                },
                "asset": {
                    "$ref": "#/$defs/asset"
                }
            }
        },
        "layer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "label",
                "components"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "number": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9
                },
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                },
                "subtitle": {
                    "type": "string",
                    "maxLength": 52
                },
                "tone": {
                    "$ref": "#/$defs/tone"
                },
                "asset": {
                    "$ref": "#/$defs/asset"
                },
                "components": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                        "$ref": "#/$defs/component"
                    }
                }
            }
        },
        "concern": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "label"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 36
                },
                "description": {
                    "type": "string",
                    "maxLength": 60
                },
                "tone": {
                    "$ref": "#/$defs/tone"
                },
                "asset": {
                    "$ref": "#/$defs/asset"
                }
            }
        }
    }
}