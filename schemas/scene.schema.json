{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://local.fluent-slide-kit/schemas/scene.schema.json",
    "title": "Resolved presentation scene",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "deckId",
        "title",
        "brandProfile",
        "brandStatus",
        "canvas",
        "slides"
    ],
    "properties": {
        "schemaVersion": {
            "const": 1
        },
        "deckId": {
            "$ref": "#/$defs/id"
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "brandProfile": {
            "type": "string",
            "minLength": 1
        },
        "brandStatus": {
            "enum": [
                "aligned-not-certified",
                "approved-internal",
                "custom-approved"
            ]
        },
        "source": {
            "type": "string"
        },
        "canvas": {
            "$ref": "#/$defs/boxSize"
        },
        "slides": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/slide"
            }
        }
    },
    "$defs": {
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "boxSize": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "width",
                "height"
            ],
            "properties": {
                "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                }
            }
        },
        "box": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "x",
                "y",
                "width",
                "height"
            ],
            "properties": {
                "x": {
                    "type": "number",
                    "minimum": 0
                },
                "y": {
                    "type": "number",
                    "minimum": 0
                },
                "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                }
            }
        },
        "style": {
            "type": "object",
            "additionalProperties": true
        },
        "element": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "type",
                "box",
                "z"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "type": {
                    "enum": [
                        "text",
                        "shape",
                        "line",
                        "image",
                        "diagram"
                    ]
                },
                "role": {
                    "type": "string"
                },
                "box": {
                    "$ref": "#/$defs/box"
                },
                "z": {
                    "type": "integer",
                    "minimum": 0
                },
                "text": {
                    "type": "string"
                },
                "shape": {
                    "enum": [
                        "rect",
                        "roundRect",
                        "ellipse",
                        "diamond"
                    ]
                },
                "path": {
                    "type": "string"
                },
                "assetKind": {
                    "enum": [
                        "fluent",
                        "azure",
                        "image"
                    ]
                },
                "alt": {
                    "type": "string"
                },
                "diagramPath": {
                    "type": "string"
                },
                "style": {
                    "$ref": "#/$defs/style"
                },
                "metadata": {
                    "type": "object",
                    "additionalProperties": true
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "text"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "text",
                            "style"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "shape"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "shape",
                            "style"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "image"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "path",
                            "assetKind",
                            "alt"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "diagram"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "diagramPath",
                            "alt"
                        ]
                    }
                }
            ]
        },
        "slide": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "number",
                "layout",
                "title",
                "takeaway",
                "theme",
                "elements",
                "notes",
                "sources"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "number": {
                    "type": "integer",
                    "minimum": 1
                },
                "layout": {
                    "type": "string",
                    "minLength": 1
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "takeaway": {
                    "type": "string",
                    "minLength": 1
                },
                "theme": {
                    "enum": [
                        "light",
                        "dark"
                    ]
                },
                "elements": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/element"
                    }
                },
                "notes": {
                    "type": "string"
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "type": "object"
                    }
                }
            }
        }
    }
}