{
    "json.schemas": [
        {
            "fileMatch": [
                "/decks/*.json",
                "/examples/*.json"
            ],
            "url": "./schemas/composition.schema.json"
        },
        {
            "fileMatch": [
                "/diagrams/*.json",
                "/diagrams/templates/*.json"
            ],
            "url": "./schemas/diagram.schema.json"
        },
        {
            "fileMatch": [
                "/design/brand-profiles/*.json"
            ],
            "url": "./schemas/brand-profile.schema.json"
        },
        {
            "fileMatch": [
                "*.scene.json"
            ],
            "url": "./schemas/scene.schema.json"
        }
    ]
}