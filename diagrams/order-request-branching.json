{
    "schemaVersion": 1,
    "diagramType": "flow",
    "id": "order-request-branching",
    "title": "Order requests branch without losing control",
    "description": "Order requests enter through Azure Front Door, run on AKS, and branch to an immediate Azure Cosmos DB write or an asynchronous work queue before persistence.",
    "direction": "right",
    "theme": "light",
    "nodes": [
        {
            "id": "front-door",
            "label": "Azure Front Door",
            "description": "Global request entry",
            "kind": "azure-service",
            "tone": "brand",
            "lane": "edge",
            "asset": {
                "kind": "azure",
                "path": "assets/azure-public-service-icons/svg/networking/10073-icon-service-Front-Door-and-CDN-Profiles.svg",
                "alt": "Azure Front Door and CDN Profiles"
            }
        },
        {
            "id": "aks",
            "label": "Azure Kubernetes Service",
            "description": "Order API workloads",
            "kind": "azure-service",
            "tone": "brand",
            "lane": "application",
            "asset": {
                "kind": "azure",
                "path": "assets/azure-public-service-icons/svg/containers/10023-icon-service-Kubernetes-Services.svg",
                "alt": "Azure Kubernetes Service"
            }
        },
        {
            "id": "operation-decision",
            "label": "Long-running operation?",
            "kind": "decision",
            "tone": "neutral",
            "lane": "application"
        },
        {
            "id": "work-queue",
            "label": "Work queue",
            "description": "Asynchronous handoff",
            "kind": "queue",
            "tone": "brand",
            "lane": "data-messaging"
        },
        {
            "id": "cosmos-db",
            "label": "Azure Cosmos DB",
            "description": "Order state",
            "kind": "azure-service",
            "tone": "success",
            "lane": "data-messaging",
            "asset": {
                "kind": "azure",
                "path": "assets/azure-public-service-icons/svg/databases/10121-icon-service-Azure-Cosmos-DB.svg",
                "alt": "Azure Cosmos DB"
            }
        }
    ],
    "edges": [
        {
            "id": "edge-to-api",
            "source": "front-door",
            "target": "aks",
            "label": "HTTPS"
        },
        {
            "id": "api-to-decision",
            "source": "aks",
            "target": "operation-decision",
            "label": "request"
        },
        {
            "id": "write-now",
            "source": "operation-decision",
            "target": "cosmos-db",
            "label": "No: write now"
        },
        {
            "id": "queue-work",
            "source": "operation-decision",
            "target": "work-queue",
            "label": "Yes: queue",
            "kind": "asynchronous"
        },
        {
            "id": "persist-work",
            "source": "work-queue",
            "target": "cosmos-db",
            "label": "persist",
            "kind": "asynchronous"
        }
    ],
    "lanes": [
        {
            "id": "edge",
            "label": "Edge"
        },
        {
            "id": "application",
            "label": "Application"
        },
        {
            "id": "data-messaging",
            "label": "Data and messaging"
        }
    ],
    "legend": [
        {
            "label": "Synchronous",
            "kind": "primary"
        },
        {
            "label": "Asynchronous",
            "kind": "asynchronous"
        }
    ]
}