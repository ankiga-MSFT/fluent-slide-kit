                    }
                },
                {
                    "id": "internal-access",
                    "label": "TPID-scoped access",
                    "description": "Assigned teams see assigned TPIDs",
                    "column": "internal",
                    "tone": "warning",
                    "asset": {
                        "kind": "fluent",
                        "path": "assets/fluent-system-icons/svg/regular/lock-closed.svg",
