{
    "schemaVersion": 1,
    "diagramType": "layered-architecture",
    "id": "advisor-kusto-publishing",
    "title": "Advisor data serves customers and internal teams",
    "description": "Advisor computes one recommendation dataset, publishes it to Azure Resource Graph for customers and internal Kusto for first-party teams, and applies a distinct authorization model to each path.",
    "theme": "light",
    "columns": [
        {
            "id": "production",
            "label": "Data production"
        },
        {
            "id": "customer",
            "label": "Customer experience"
        },
        {
            "id": "internal",
            "label": "Internal 1P analytics"
        }
    ],
    "layers": [
        {
            "id": "compute",
            "number": 1,
            "label": "Compute once",
            "tone": "brand",
            "components": [
                {
                    "id": "advisor-engine",
                    "label": "Advisor engine",
                    "description": "Scheduled recommendation computation",
                    "column": "production",
                    "span": 3,
                    "tone": "brand",
                    "emphasis": true,
                    "asset": {
                        "kind": "azure",
                        "path": "assets/azure-public-service-icons/svg/management + governance/00003-icon-service-Advisor.svg",
                        "alt": "Azure Advisor"
                    }
                }
            ]
        },
        {
            "id": "publish",
            "number": 2,
            "label": "Publish by channel",
            "tone": "neutral",
            "components": [
                {
                    "id": "recommendation-data",
                    "label": "Recommendation dataset",
                    "description": "Snapshots, scores, and tracking metadata",
                    "column": "production",
                    "tone": "neutral"
                },
                {
                    "id": "resource-graph",
                    "label": "Azure Resource Graph",
                    "description": "Customer-facing recommendation data",
                    "column": "customer",
                    "tone": "brand",
                    "asset": {
                        "kind": "azure",
                        "path": "assets/azure-public-service-icons/svg/management + governance/10318-icon-service-Resource-Graph-Explorer.svg",
                        "alt": "Azure Resource Graph"
                    }
                },
                {
                    "id": "kusto",
                    "label": "1P Kusto clusters",
                    "description": "Internal data across customers",
                    "column": "internal",
                    "tone": "brand",
                    "asset": {
                        "kind": "azure",
                        "path": "assets/azure-public-service-icons/svg/databases/10145-icon-service-Azure-Data-Explorer-Clusters.svg",
                        "alt": "Azure Data Explorer clusters"
                    }
                }
            ]
        },
        {
            "id": "consume",
            "number": 3,
            "label": "Authorize consumption",
            "tone": "success",
            "components": [
                {
                    "id": "customer-access",
                    "label": "ARM / ARG access",
