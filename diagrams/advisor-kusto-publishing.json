    "crossCuttingConcerns": [
        {
            "id": "freshness",
            "label": "Scheduled freshness",
            "tone": "brand"
        },
        {
            "id": "scope",
            "label": "Separate scope models",
            "tone": "warning"
        },
        {
            "id": "audit",
