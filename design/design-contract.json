{
    "schemaVersion": 1,
    "alignment": "Fluent 2 public design guidance",
    "notABrandCertification": true,
    "canonicalCanvas": {
        "width": 1920,
        "height": 1080,
        "aspectRatio": "16:9"
    },
    "outputMode": {
        "staticOnly": true,
        "completeMessagePerFrame": true,
        "forbidden": [
            "animation",
            "slide-transition",
            "autoplay",
            "hover-dependent-content",
            "interactive-control",
            "loading-state",
            "motion-dependent-meaning"
        ]
    },
    "authoringDefaults": {
        "containers": {
            "fill": "$surface",
            "lightResolvedFill": "#FFFFFF",
            "nonWhiteFillRequires": "Explicit user direction or documented focal or semantic intent",
            "exceptionMetadata": "fillIntent"
        },
        "connectors": {
            "color": "$secondary",
            "lightResolvedColor": "#424242",
            "width": 2.5,
            "arrowhead": "filled-triangle",
            "exceptionMetadata": "connectorIntent",
            "marker": {
                "width": 10,
                "height": 10,
                "refX": 9,
                "refY": 3,
                "path": "M0,0 L0,6 L9,3 z",
                "units": "strokeWidth"
            }
        }
    },
    "typography": {
        "fontStack": "Segoe UI Variable Display, Segoe UI Variable, Segoe UI, system-ui, sans-serif",
        "note": "Segoe UI binaries are not redistributed. Slide aliases are larger than the Fluent UI type ramp for projected readability.",
        "fluentFoundation": "design/fluent-foundation.json",
        "roles": {
            "display": 72,
            "title": 48,
            "subtitle": 30,
            "body": 24,
            "caption": 18,
            "stat": 96
        }
    },
    "contentBudgets": {
        "titleWords": 10,
        "bodyWords": 55
    },
    "foundations": {
        "fluent": "design/fluent-foundation.json",
        "dataVisualization": "design/fluent-chart-foundation.json",
        "usage": "Use these attributed snapshots as authoring inputs. Brand-profile presentation aliases remain the renderer-facing contract."
    },
    "diagramQuality": {
        "canvas": {
            "width": 1600,
            "height": 720
        },
        "minimumEffectiveFontSize": 18,
        "maximumFlowNodes": 18,
        "maximumArchitectureComponents": 15,
        "maximumArchitectureColumns": 5,
        "maximumArchitectureLayers": 6,
        "maximumCrossCuttingConcerns": 5,
        "minimumLayerConnectorLength": 24,
        "minimumNodeContentGap": 4,
        "minimumCornerRadius": 6,
        "maximumItemCollisions": 0,
        "maximumConnectorCrossings": 0,
        "allowTextOutsideContainer": false
    },
    "powerPointQuality": {
        "canvas": {
            "width": 1920,
            "height": 1080
        },
        "requireSceneElementCoverage": true,
        "requireSpeakerNotes": true,
        "requireRoundedContainers": true,
        "allowScreenshotOnlySlides": false,
        "minimumPreviewNonWhiteRatio": 0.01,
        "minimumPreviewSampledColors": 5
    },
    "sources": [
        "https://fluent2.microsoft.design/design-principles",
        "https://fluent2.microsoft.design/color",
        "https://fluent2.microsoft.design/typography",
        "https://fluent2.microsoft.design/layout",
        "https://fluent2.microsoft.design/iconography"
    ]
}